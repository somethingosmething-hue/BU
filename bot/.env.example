# Rename this file to .env and add your bot token
# Then go to HeavenCloud Variables section and add:
# Name: BOT_TOKEN
# Value: your_actual_bot_token

BOT_TOKEN=

# Autobumper user token (the account that fires /bump). Optional if set via /ab.
# WARNING: selfbot automation risks the account. Use an alt, never your main.
USER_TOKEN=